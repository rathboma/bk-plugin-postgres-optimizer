{
  "name": "bk-plugin-postgres-optimizer",
  "private": true,
  "version": "0.1.0",
  "description": "Find slow queries, missing indexes and performance problems in PostgreSQL from inside Beekeeper Studio",
  "license": "GPL-3.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "harness": "node dev/server.mjs"
  },
  "devDependencies": {
    "@beekeeperstudio/plugin": "1.7.2",
    "@beekeeperstudio/vite-plugin": "^1.1.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6",
    "pg": "^8.23.1",
    "typescript": "~5.9",
    "vite": "^7",
    "vitest": "^3",
    "vue": "^3.5",
    "vue-tsc": "^3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
